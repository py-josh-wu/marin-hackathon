import os
import json
import time
import threading
import tkinter as tk
from tkinter import messagebox

# ==========================================
# CONFIGURATION & STORAGE (Single-File JSON)
# ==========================================
CONFIG_FILE = "bob_config.json"

DEFAULT_CONFIG = {
    "first_run": True,
    "trigger_phrase": "hey bobify, can i buy a banana from hannah?",
    "contacts": "Mom (+1 555-0199), 911 Emergency Dispatch",
    "covert_mode": True
}

def load_config():
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_CONFIG

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


# ==========================================
# MAIN APPLICATION CLASS
# ==========================================
class BobShopApp(tk.Tk):
    def __init__(self):
        super().__init__()

        # Window Settings
        self.title("Bob Shop")
        self.geometry("400x720")
        self.configure(bg="#0F0F11")
        self.resizable(False, False)

        self.config_data = load_config()
        self.is_listening = True

        # Start Background Voice Recognition Listener Thread
        self.listener_thread = threading.Thread(target=self._background_mic_listener, daemon=True)
        self.listener_thread.start()

        # Route Screen Based on Application State
        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    # --- CANVAS-DRAWN WHITE & BLACK SHOPPING BAG LOGO ---
    def _draw_shopping_bag_logo(self, canvas, center_x, center_y):
        """Draws a crisp white & black minimalist shopping bag icon directly on canvas."""
        # Bag Body
        canvas.create_rectangle(
            center_x - 18, center_y - 10, center_x + 18, center_y + 22,
            outline="#FFFFFF", width=3, fill="#0F0F11"
        )
        # Bag Handle
        canvas.create_arc(
            center_x - 10, center_y - 20, center_x + 10, center_y - 2,
            start=0, extent=180, outline="#FFFFFF", width=3, style=tk.ARC
        )

    # ==========================================
    # 1. TUTORIAL / FIRST-RUN ONBOARDING SCREEN
    # ==========================================
    def show_tutorial(self):
        self._clear_window()

        # Top Header Bar
        header_canvas = tk.Canvas(self, bg="#18181B", height=110, highlightthickness=0)
        header_canvas.pack(fill="x")
        
        # Vector Logo
        self._draw_shopping_bag_logo(header_canvas, 200, 38)
        
        header_canvas.create_text(
            200, 82, text="BOB SHOP", fill="#FFFFFF",
            font=("Helvetica", 14, "bold")
        )

        # Main Body Scrollable Container Frame
        body = tk.Frame(self, bg="#0F0F11", padx=20, pady=15)
        body.pack(fill="both", expand=True)

        # Section Pill
        lbl_badge = tk.Label(
            body, text="SAFETY ASSISTANT SETUP", font=("Helvetica", 9, "bold"),
            fg="#A1A1AA", bg="#27272A", padx=8, pady=3
        )
        lbl_badge.pack(anchor="w", pady=(0, 10))

        # Instructions Box
        card_intro = tk.Frame(body, bg="#18181B", padx=15, pady=12)
        card_intro.pack(fill="x", pady=(0, 15))

        intro_text = (
            "Bob Shop is a covert personal safety tool disguised as a store.\n\n"
            "• Silent Listening: Operates in background to detect your distress phrase.\n"
            "• Disguise: Re-opening the app presents a regular produce store.\n"
            "• Emergency Protocol: Saying your secret phrase alerts contacts or 911."
        )
        lbl_intro = tk.Label(
            card_intro, text=intro_text, font=("Helvetica", 10),
            fg="#D4D4D8", bg="#18181B", justify="left", wraplength=310
        )
        lbl_intro.pack(anchor="w")

        # Config Inputs
        tk.Label(body, text="Activation Phrase:", font=("Helvetica", 10, "bold"), fg="#FFFFFF", bg="#0F0F11").pack(anchor="w", pady=(5, 2))
        self.ent_phrase = tk.Entry(
            body, font=("Helvetica", 11), bg="#18181B", fg="#FFFFFF",
            insertbackground="#FFFFFF", bd=0, highlightthickness=1, highlightbackground="#27272A"
        )
        self.ent_phrase.insert(0, self.config_data["trigger_phrase"])
        self.ent_phrase.pack(fill="x", ipady=8, pady=(0, 12))

        tk.Label(body, text="Emergency Contacts:", font=("Helvetica", 10, "bold"), fg="#FFFFFF", bg="#0F0F11").pack(anchor="w", pady=(5, 2))
        self.ent_contacts = tk.Entry(
            body, font=("Helvetica", 11), bg="#18181B", fg="#FFFFFF",
            insertbackground="#FFFFFF", bd=0, highlightthickness=1, highlightbackground="#27272A"
        )
        self.ent_contacts.insert(0, self.config_data["contacts"])
        self.ent_contacts.pack(fill="x", ipady=8, pady=(0, 20))

        # Complete Setup Button
        btn_complete = tk.Button(
            self, text="SAVE & LAUNCH STORE DISGUISE", font=("Helvetica", 11, "bold"),
            bg="#FFFFFF", fg="#000000", activebackground="#E4E4E7", activeforeground="#000000",
            bd=0, pady=12, cursor="hand2", command=self._finish_tutorial
        )
        btn_complete.pack(fill="x", padx=20, pady=20, side="bottom")

    def _finish_tutorial(self):
        phrase = self.ent_phrase.get().strip().lower()
        contacts = self.ent_contacts.get().strip()

        if not phrase or not contacts:
            messagebox.showwarning("Incomplete Setup", "Please specify both a secret phrase and emergency contacts.")
            return

        self.config_data["trigger_phrase"] = phrase
        self.config_data["contacts"] = contacts
        self.config_data["first_run"] = False
        save_config(self.config_data)

        self.show_store_interface()

    # ==========================================
    # 2. DISGUISED MODERN SHOPPING INTERFACE
    # ==========================================
    def show_store_interface(self):
        self._clear_window()

        # Top Navigation Bar
        top_bar = tk.Frame(self, bg="#18181B", height=60)
        top_bar.pack(fill="x")
        top_bar.pack_propagate(False)

        # Logo Canvas
        logo_canvas = tk.Canvas(top_bar, bg="#18181B", width=45, height=50, highlightthickness=0)
        logo_canvas.pack(side="left", padx=(15, 5), pady=5)
        self._draw_shopping_bag_logo(logo_canvas, 22, 28)

        lbl_title = tk.Label(top_bar, text="BOB SHOP", font=("Helvetica", 13, "bold"), fg="#FFFFFF", bg="#18181B")
        lbl_title.pack(side="left")

        # Discreet Gear/Settings Button
        btn_settings = tk.Button(
            top_bar, text="⚙️", font=("Helvetica", 12), bg="#18181B", fg="#A1A1AA",
            activebackground="#18181B", activeforeground="#FFFFFF", bd=0, cursor="hand2",
            command=self.show_tutorial
        )
        btn_settings.pack(side="right", padx=15)

        # Store Feed
        content = tk.Frame(self, bg="#0F0F11", padx=15, pady=15)
        content.pack(fill="both", expand=True)

        tk.Label(content, text="Fresh Produce Catalog", font=("Helvetica", 12, "bold"), fg="#FFFFFF", bg="#0F0F11").pack(anchor="w", pady=(0, 10))

        # Product Items List
        products = [
            ("Organic Bananas", "$1.29 / lb", "🍌"),
            ("Fuji Apples", "$2.49 / lb", "🍎"),
            ("Valencia Oranges", "$1.99 / lb", "🍊"),
            ("Fresh Strawberries", "$3.99 / box", "🍓"),
            ("Avocado Bag", "$4.50 / ea", "🥑")
        ]

        for name, price, icon in products:
            card = tk.Frame(content, bg="#18181B", highlightbackground="#27272A", highlightthickness=1, padx=12, pady=10)
            card.pack(fill="x", pady=5)

            lbl_icon = tk.Label(card, text=icon, font=("Segoe UI Emoji", 20), bg="#18181B")
            lbl_icon.pack(side="left", padx=(0, 12))

            info = tk.Frame(card, bg="#18181B")
            info.pack(side="left")

            tk.Label(info, text=name, font=("Helvetica", 10, "bold"), fg="#FFFFFF", bg="#18181B").pack(anchor="w")
            tk.Label(info, text=price, font=("Helvetica", 9), fg="#A1A1AA", bg="#18181B").pack(anchor="w")

            btn_buy = tk.Button(
                card, text="Add", font=("Helvetica", 9, "bold"), bg="#27272A", fg="#FFFFFF",
                activebackground="#3F3F46", activeforeground="#FFFFFF", bd=0, padx=10, pady=4, cursor="hand2",
                command=lambda n=name: messagebox.showinfo("Bob Shop", f"Added {n} to cart.")
            )
            btn_buy.pack(side="right")

        # Bottom Safety Status Bar
        footer = tk.Frame(self, bg="#18181B", height=28)
        footer.pack(fill="x", side="bottom")

        lbl_mic = tk.Label(footer, text="● Live Protection Active", font=("Helvetica", 8), fg="#22C55E", bg="#18181B")
        lbl_mic.pack(pady=5)

    # ==========================================
    # 3. BACKGROUND AUDIO LISTENER & DISPATCH
    # ==========================================
    def _background_mic_listener(self):
        """Attempts microphone audio listening using SpeechRecognition if available."""
        try:
            import speech_recognition as sr
            recognizer = sr.Recognizer()
            mic = sr.Microphone()

            with mic as source:
                recognizer.adjust_for_ambient_noise(source, duration=1)

            while self.is_listening:
                try:
                    with mic as source:
                        audio = recognizer.listen(source, timeout=3, phrase_time_limit=5)
                    text = recognizer.recognize_google(audio).lower()

                    target = self.config_data.get("trigger_phrase", "").lower()
                    if target in text:
                        self._trigger_alert(text)

                except (sr.WaitTimeoutError, sr.UnknownValueError):
                    pass
                except Exception:
                    time.sleep(1)

        except ImportError:
            # Fallback loop when PyAudio or SpeechRecognition packages aren't present
            while self.is_listening:
                time.sleep(2)

    def _trigger_alert(self, detected_text):
        contacts = self.config_data.get("contacts", "")
        print("\n" + "="*50)
        print("🚨 [COVERT EMERGENCY PROTOCOL ACTIVATED] 🚨")
        print(f"Detected Trigger: '{detected_text}'")
        print(f"Dispatching Alert to Contacts: {contacts}")
        print("="*50 + "\n")

        self.after(0, lambda: messagebox.showwarning(
            "Protocol Triggered",
            f"[TEST MODE] Trigger phrase detected!\n\nAlert sent to contacts:\n{contacts}"
        ))

    def _clear_window(self):
        for widget in self.winfo_children():
            widget.destroy()


# ==========================================
# EXECUTION ENTRY POINT
# ==========================================
if __name__ == "__main__":
    app = BobShopApp()
    app.mainloop()
