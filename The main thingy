TWILIO_ACCOUNT_SID = "YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN = "YOUR_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER = "+18005550199"  # Your Twilio virtual phone number

def send_real_sms(to_number, message_body):
    """Utility function to dispatch real SMS via Twilio API."""
    if not TWILIO_SUPPORTED:
        print("❌ Twilio SDK not installed. Text not sent.")
        return False
        
    if TWILIO_ACCOUNT_SID == "YOUR_TWILIO_ACCOUNT_SID":
        print("⚠️ Twilio API credentials not configured. Please add SID and Token to app.py.")
        return False

    def _send_thread():
        try:
            client = Client(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)
            message = client.messages.create(
                body=message_body,
                from_=TWILIO_PHONE_NUMBER,
                to=to_number
            )
            print(f"✅ SMS successfully sent to {to_number}! Message SID: {message.sid}")
        except Exception as e:
            print(f"❌ Failed to send SMS to {to_number}: {e}")

    # Send in a background thread so the GUI doesn't freeze
    threading.Thread(target=_send_thread, daemon=True).start()
    return True


