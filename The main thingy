def get_current_location():
    """Retrieves approximate location coordinates via IP geolocation services."""
    try:
        req = urllib.request.Request(
            "https://ipinfo.io/json",
            headers={"User-Agent": "Mozilla/5.0"}
        )
        with urllib.request.urlopen(req, timeout=4) as response:
            data = json.loads(response.read().decode())
            loc = data.get("loc", "").split(",")
            city = data.get("city", "Unknown City")
            region = data.get("region", "")
            if len(loc) == 2:
                lat, lng = loc[0], loc[1]
                maps_url = f"https://maps.google.com/?q={lat},{lng}"
                return f"{city}, {region} ({lat}, {lng})\nMaps Link: {maps_url}"
    except Exception as e:
        print(f"⚠️ Location lookup failed: {e}")
    
    return "Location Unavailable (Enable GPS/Network connection)"


def send_real_sms(account_sid, auth_token, from_number, to_number, message_body):
    """Utility function to dispatch real SMS via Twilio API."""
    if not TWILIO_SUPPORTED:
        print("❌ Twilio SDK not installed. Text not sent.")
        return False, "Twilio SDK (twilio) is not installed. Run 'pip install twilio'."

    if not account_sid or not auth_token or not from_number:
        print("⚠️ Missing Twilio credentials in configuration.")
        return False, "Twilio credentials incomplete. Please check Settings."

    def _send_thread():
        try:
            client = Client(account_sid, auth_token)
            message = client.messages.create(
                body=message_body,
                from_=from_number,
                to=to_number
            )
            print(f"✅ SMS successfully sent to {to_number}! Message SID: {message.sid}")
        except Exception as e:
            print(f"❌ Failed to send SMS to {to_number}: {e}")

    threading.Thread(target=_send_thread, daemon=True).start()
    return True, "SMS dispatched successfully."


