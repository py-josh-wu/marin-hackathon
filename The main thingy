"""BobShop: transparent, accessibility-first emergency-tool catalog.
"""BobShop — a no-install Python desktop safety-tool catalog.

Install for desktop preview:  pip install kivy plyer
For Android packaging, use Buildozer and declare CALL_PHONE, SEND_SMS, and
ACCESS_FINE_LOCATION permissions only if your release actually needs them.
Run: python3 bobshop.py
Uses only the Python standard library (Tkinter).
"""
from kivy.app import App
from kivy.lang import Builder
from kivy.properties import BooleanProperty, StringProperty
from kivy.uix.popup import Popup
from kivy.uix.label import Label
from kivy.utils import platform
import json
import os
import urllib.parse
import webbrowser
import tkinter as tk
from tkinter import messagebox

try:
    from plyer import sms, tts, gps
except ImportError:  # Makes the UI previewable before device integrations exist.
    sms = tts = gps = None

BG = "#F7F3EC"
INK = "#213432"
MUTED = "#63716E"
TEAL = "#27655F"
CORAL = "#E46B4C"
CARD = "#FFFFFF"
SETTINGS_FILE = "bobshop_settings.json"

KV = '''
#:import dp kivy.metrics.dp
<ProductButton@Button>:
    background_normal: ''
    background_color: '#FFFFFF'
    color: '#1E2927'
    font_size: '16sp'
    halign: 'left'
    valign: 'middle'
    text_size: self.width - dp(28), self.height
    padding: dp(14), dp(10)

BoxLayout:
    orientation: 'vertical'
    padding: dp(20)
    spacing: dp(12)
    canvas.before:
        Color:
            rgb: 1, .976, .945
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: 'BobShop'
        color: '#214E4A'
        font_size: '31sp'
        bold: True
        size_hint_y: None
        height: dp(45)
        halign: 'left'
        text_size: self.width, self.height
    Label:
        text: 'Safety tools catalog — every item clearly explains its action.'
        color: '#52615E'
        size_hint_y: None
        height: dp(42)
        halign: 'left'
        text_size: self.width, self.height
    ProductButton:
        text: '🛟  Safety Float    $0.00\\nCall emergency services'
        on_release: app.confirm_call()
    ProductButton:
        text: '📦  Care Package    $0.00\\nMessage a trusted contact'
        on_release: app.message_contact()
    ProductButton:
        text: '📍  Location Pin    $0.00\\nShare your current location'
        on_release: app.share_location()
    ProductButton:
        text: '🔔  Bobify Guide    $0.00\\nHear the emergency options aloud'
        on_release: app.bobify()
    Widget:
    Button:
        text: 'Safety settings'
        size_hint_y: None
        height: dp(50)
        background_normal: ''
        background_color: '#E96A47'
        on_release: app.show_settings()
'''
class BobShop(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("BobShop")
        self.geometry("480x720")
        self.minsize(420, 620)
        self.configure(bg=BG)
        self.settings = self.load_settings()
        self.build_ui()

    def load_settings(self):
        data = {"emergency_number": "911", "trusted_contact": ""}
        try:
            with open(SETTINGS_FILE, "r", encoding="utf-8") as file:
                data.update(json.load(file))
        except (OSError, json.JSONDecodeError):
            pass
        return data

class BobShop(App):
    emergency_number = StringProperty('911')
    trusted_contact = StringProperty('')
    voice_guidance = BooleanProperty(True)
    def save_settings(self):
        with open(SETTINGS_FILE, "w", encoding="utf-8") as file:
            json.dump(self.settings, file)

    def build(self):
        self.title = 'BobShop'
        return Builder.load_string(KV)
    def label(self, parent, text, size=12, color=INK, bold=False, **kwargs):
        return tk.Label(parent, text=text, bg=parent["bg"], fg=color,
                        font=("Helvetica", size, "bold" if bold else "normal"), **kwargs)

    def popup(self, title, message):
        Popup(title=title, content=Label(text=message, padding=(20, 20)),
              size_hint=(.85, None), height=190).open()
    def build_ui(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=28, pady=(28, 16))
        self.label(top, "BobShop", 30, TEAL, True, anchor="w").pack(side="left")
        tk.Button(top, text="⚙", command=self.open_settings, font=("Helvetica", 20),
                  bg=BG, fg=TEAL, bd=0, activebackground=BG, cursor="hand2").pack(side="right")

    def speak(self, message):
        if self.voice_guidance and tts:
            tts.speak(message)
        header = tk.Frame(self, bg=BG)
        header.pack(fill="x", padx=28)
        self.label(header, "Your safety tools", 22, INK, True, anchor="w").pack(fill="x")
        self.label(header, "Each item clearly tells you what it will do.", 12, MUTED,
                   anchor="w", pady=6).pack(fill="x")

    def confirm_call(self):
        # This confirmation is deliberate: no emergency action is hidden.
        self.popup('Call emergency services?',
                   'This action would call {}. Only continue in an emergency.\n\n'
                   'On Android, connect this button to an intent after obtaining '
                   'the appropriate permission and showing a final confirmation.'.format(self.emergency_number))
        products = tk.Frame(self, bg=BG)
        products.pack(fill="both", expand=True, padx=28, pady=(14, 8))
        self.product(products, "🛟", "Safety Float", "Call emergency services", self.call_emergency)
        self.product(products, "✉", "Care Package", "Message a trusted contact", self.message_contact)
        self.product(products, "⌖", "Location Pin", "Create a shareable map link", self.share_location)
        self.product(products, "✦", "Bobify Guide", "Read these options aloud", self.bobify)

        foot = tk.Frame(self, bg="#E9F0ED")
        foot.pack(fill="x", padx=28, pady=(8, 28))
        tk.Label(foot, text="Bobify is designed for clear, calm guidance.", bg="#E9F0ED", fg=TEAL,
                 font=("Helvetica", 11, "bold"), pady=14).pack()

    def product(self, parent, icon, title, description, command):
        card = tk.Frame(parent, bg=CARD, highlightthickness=1, highlightbackground="#E4E8E3")
        card.pack(fill="x", pady=6)
        card.bind("<Button-1>", lambda _event: command())
        icon_label = tk.Label(card, text=icon, bg=CARD, fg=TEAL, font=("Helvetica", 25), width=3, pady=16)
        icon_label.pack(side="left")
        copy = tk.Frame(card, bg=CARD)
        copy.pack(side="left", fill="both", expand=True, pady=12)
        tk.Label(copy, text=title, bg=CARD, fg=INK, font=("Helvetica", 14, "bold"), anchor="w").pack(fill="x")
        tk.Label(copy, text=description, bg=CARD, fg=MUTED, font=("Helvetica", 11), anchor="w").pack(fill="x", pady=(3, 0))
        arrow = tk.Label(card, text="›", bg=CARD, fg=CORAL, font=("Helvetica", 25), padx=15)
        arrow.pack(side="right")
        for widget in (icon_label, copy, arrow, *copy.winfo_children()):
            widget.bind("<Button-1>", lambda _event: command())

    def call_emergency(self):
        number = self.settings["emergency_number"]
        if messagebox.askyesno("Call emergency services?", f"This will open your phone app to call {number}.\n\nContinue only in an emergency."):
            webbrowser.open(f"tel:{number}")

    def message_contact(self):
        if not self.trusted_contact:
            self.popup('Add a trusted contact', 'Set a phone number in Safety settings first.')
        contact = self.settings["trusted_contact"]
        if not contact:
            messagebox.showinfo("Add a contact", "Add a trusted contact in Safety settings first.")
            return
        if sms:
            sms.send(recipient=self.trusted_contact, message='I need help. Please check in with me.')
        else:
            self.popup('Message trusted contact', 'Would open the system message composer for {}.'.format(self.trusted_contact))
        message = urllib.parse.quote("I need help. Please check in with me.")
        webbrowser.open(f"sms:{contact}?body={message}")

    def share_location(self):
        if not gps:
            self.popup('Share location', 'Location sharing requires a device build with Plyer GPS support.')
            return
        gps.configure(on_location=self._got_location)
        gps.start(minTime=1000, minDistance=0)
        self.popup('Finding location', 'BobShop is requesting your location to create a shareable link.')
        dialog = tk.Toplevel(self)
        dialog.title("Share location")
        dialog.configure(bg=BG)
        dialog.resizable(False, False)
        tk.Label(dialog, text="Create a location link", bg=BG, fg=INK, font=("Helvetica", 18, "bold"), pady=18).pack()
        tk.Label(dialog, text="Enter coordinates from your maps app.", bg=BG, fg=MUTED).pack(padx=28)
        lat, lon = tk.Entry(dialog, width=32), tk.Entry(dialog, width=32)
        for label, entry in (("Latitude", lat), ("Longitude", lon)):
            tk.Label(dialog, text=label, bg=BG, fg=INK, anchor="w").pack(fill="x", padx=28, pady=(14, 3))
            entry.pack(padx=28, fill="x")
        def create_link():
            if not lat.get().strip() or not lon.get().strip():
                messagebox.showwarning("Coordinates needed", "Enter both latitude and longitude.", parent=dialog)
                return
            webbrowser.open(f"https://maps.google.com/?q={lat.get().strip()},{lon.get().strip()}")
            dialog.destroy()
        tk.Button(dialog, text="Open shareable map link", command=create_link, bg=CORAL, fg="white",
                  bd=0, padx=16, pady=10, font=("Helvetica", 11, "bold")).pack(pady=24)

    def _got_location(self, **location):
        gps.stop()
        link = 'https://maps.google.com/?q={lat},{lon}'.format(**location)
        self.popup('Location ready', 'Share this location link through your preferred app:\n{}'.format(link))

    def bobify(self):
        message = ('Bobify guide. Safety Float calls emergency services. '
                   'Care Package messages your trusted contact. '
                   'Location Pin shares your current location.')
        self.speak(message)
        self.popup('Bobify is speaking', message)
        message = ("Bobify guide. Safety Float opens an emergency call. Care Package opens a message to your trusted contact. "
                   "Location Pin creates a map link you can share.")
        self.bell()
        messagebox.showinfo("Bobify guide", message)

    def show_settings(self):
        self.popup('Safety settings',
                   'Configure an emergency number and trusted contact in your '
                   'production settings screen. Do not store contacts or location '
                   'without informed user consent.')
    def open_settings(self):
        dialog = tk.Toplevel(self)
        dialog.title("Safety settings")
        dialog.configure(bg=BG)
        dialog.resizable(False, False)
        tk.Label(dialog, text="Safety settings", bg=BG, fg=INK, font=("Helvetica", 20, "bold"), pady=18).pack()
        fields = []
        for label, key in (("Emergency number", "emergency_number"), ("Trusted contact phone", "trusted_contact")):
            tk.Label(dialog, text=label, bg=BG, fg=INK, anchor="w").pack(fill="x", padx=28, pady=(10, 3))
            entry = tk.Entry(dialog, width=34)
            entry.insert(0, self.settings[key])
            entry.pack(padx=28, fill="x")
            fields.append((key, entry))
        def save():
            for key, entry in fields:
                self.settings[key] = entry.get().strip()
            self.save_settings()
            dialog.destroy()
        tk.Button(dialog, text="Save settings", command=save, bg=TEAL, fg="white", bd=0, padx=22, pady=10,
                  font=("Helvetica", 11, "bold")).pack(pady=26)


if __name__ == '__main__':
    BobShop().run()
if __name__ == "__main__":
    BobShop().mainloop()
