def load_config():
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r") as f:
            cfg = json.load(f)
            if "fruit_contacts" not in cfg:
                cfg["fruit_contacts"] = DEFAULT_CONFIG["fruit_contacts"]
            return cfg
    except Exception:
        return DEFAULT_CONFIG

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


# ==========================================
# CUSTOM ROUNDED PILL BUTTON COMPONENT
# ==========================================
class RoundedButton(tk.Canvas):
    def __init__(self, parent, text, command=None, width=130, height=36, radius=18,
                 bg_color="#4F46E5", hover_color="#3730A3", text_color="#FFFFFF", font=("Helvetica", 9, "bold")):
        super().__init__(parent, width=width, height=height, bg=parent["bg"], highlightthickness=0)
        
        self.command = command
        self.bg_color = bg_color
        self.hover_color = hover_color
        self.text_color = text_color
        self.font = font
        self.radius = radius
        self.btn_width = width
        self.btn_height = height
        self.text = text

        self._draw(self.bg_color)

        self.bind("<Enter>", lambda e: self._draw(self.hover_color))
        self.bind("<Leave>", lambda e: self._draw(self.bg_color))
        self.bind("<Button-1>", self._on_click)

    def _draw(self, color):
        self.delete("all")
        r = self.radius
        w = self.btn_width
        h = self.btn_height

        # Draw smooth rounded rectangle (pill container)
        self.create_arc(0, 0, 2*r, 2*r, start=90, extent=90, fill=color, outline=color)
        self.create_arc(w-2*r, 0, w, 2*r, start=0, extent=90, fill=color, outline=color)
        self.create_arc(0, h-2*r, 2*r, h, start=180, extent=90, fill=color, outline=color)
        self.create_arc(w-2*r, h-2*r, w, h, start=270, extent=90, fill=color, outline=color)
        
        self.create_rectangle(r, 0, w-r, h, fill=color, outline=color)
        self.create_rectangle(0, r, w, h-r, fill=color, outline=color)

        # Centered Text Label
        self.create_text(w / 2, h / 2, text=self.text, fill=self.text_color, font=self.font)

    def _on_click(self, event):
        if self.command:
            self.command()


# ==========================================
# MAIN APPLICATION CLASS
# ==========================================
class BobShopApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("BOB SHOP")
        self.geometry("1080x900")
        self.configure(bg=THEME["bg"])
        self.resizable(True, True)
        self.minsize(950, 750)

        self.config_data = load_config()
        self.is_listening = True
        self.mic_status_text = "Initializing Protection..."
        self.mic_status_color = THEME["status_warn"]

        # Speech Listener Thread
        self.listener_thread = threading.Thread(target=self._start_speech_recognition, daemon=True)
        self.listener_thread.start()

        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    # --- BRAND LOGO ---
    def _draw_brand_logo(self, canvas, center_x, center_y, scale=1.0):
        w = 16 * scale
        h = 20 * scale
        r = 8 * scale
        canvas.create_rectangle(
            center_x - w, center_y - (h/3), center_x + w, center_y + h,
            outline=THEME["accent_primary"], width=3, fill=THEME["surface"]
        )
        canvas.create_arc(
            center_x - r, center_y - (h/3 + r), center_x + r, center_y - (h/3 - r/2),
            start=0, extent=180, outline=THEME["accent_primary"], width=3, style=tk.ARC
        )

