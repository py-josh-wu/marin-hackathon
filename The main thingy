import json
import os
import urllib.parse
import webbrowser
import tkinter as tk
from tkinter import messagebox

BG = "#F7F3EC"
INK = "#213432"
MUTED = "#63716E"
TEAL = "#27655F"
CORAL = "#E46B4C"
CARD = "#FFFFFF"
SETTINGS_FILE = "bobshop_settings.json"


class BobShop(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("BobShop")
        self.geometry("480x720")
        self.minsize(420, 620)
        self.configure(bg=BG)

        self.settings = self.load_settings()
        self.build_ui()

    def load_settings(self):
        data = {"emergency_number": "911", "trusted_contact": ""}
        try:
            with open(SETTINGS_FILE, "r", encoding="utf-8") as file:
                data.update(json.load(file))
        except (OSError, json.JSONDecodeError):
            pass
        return data

    def save_settings(self):
        with open(SETTINGS_FILE, "w", encoding="utf-8") as file:
            json.dump(self.settings, file)

    def make_label(self, parent, text, size=12, color=INK, bold=False, **kwargs):
        return tk.Label(
            parent,
            text=text,
            bg=parent["bg"],
            fg=color,
            font=("Helvetica", size, "bold" if bold else "normal"),
            **kwargs,
        )

    def build_ui(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=28, pady=(28, 16))

        self.make_label(top, "BobShop", 30, TEAL, True, anchor="w").pack(side="left")

        tk.Button(
            top,
            text="⚙",
            command=self.open_settings,
            font=("Helvetica", 20),
            bg=BG,
            fg=TEAL,
            bd=0,
            activebackground=BG,
            cursor="hand2",
        ).pack(side="right")

        header = tk.Frame(self, bg=BG)
        header.pack(fill="x", padx=28)

        self.make_label(header, "Your safety tools", 22, INK, True, anchor="w").pack(fill="x")
        self.make_label(
            header,
            "Each item clearly tells you what it will do.",
            12,
            MUTED,
            anchor="w",
            pady=6,
        ).pack(fill="x")

        products = tk.Frame(self, bg=BG)
        products.pack(fill="both", expand=True, padx=28, pady=(14, 8))

        self.product(products, "🛟", "Safety Float", "Call emergency services", self.call_emergency)
        self.product(products, "✉", "Care Package", "Message a trusted contact", self.message_contact)
        self.product(products, "⌖", "Location Pin", "Create a shareable map link", self.share_location)
        self.product(products, "✦", "Bobify Guide", "Read these options aloud", self.bobify)

        footer = tk.Frame(self, bg="#E9F0ED")
        footer.pack(fill="x", padx=28, pady=(8, 28))

        tk.Label(
            footer,
            text="Bobify is designed for clear, calm guidance.",
            bg="#E9F0ED",
            fg=TEAL,
            font=("Helvetica", 11, "bold"),
            pady=14,
        ).pack()

    def product(self, parent, icon, title, description, command):
        card = tk.Frame(parent, bg=CARD, highlightthickness=1, highlightbackground="#E4E8E3")
        card.pack(fill="x", pady=6)

        icon_label = tk.Label(card, text=icon, bg=CARD, fg=TEAL, font=("Helvetica", 25), width=3, pady=16)
        icon_label.pack(side="left")

        copy = tk.Frame(card, bg=CARD)
        copy.pack(side="left", fill="both", expand=True, pady=12)

        title_label = tk.Label(copy, text=title, bg=CARD, fg=INK, font=("Helvetica", 14, "bold"), anchor="w")
        title_label.pack(fill="x")

        description_label = tk.Label(
            copy, text=description, bg=CARD, fg=MUTED, font=("Helvetica", 11), anchor="w"
        )
        description_label.pack(fill="x", pady=(3, 0))

        arrow = tk.Label(card, text="›", bg=CARD, fg=CORAL, font=("Helvetica", 25), padx=15)
        arrow.pack(side="right")

        for widget in (card, icon_label, copy, title_label, description_label, arrow):
            widget.bind("<Button-1>", lambda event: command())

    def call_emergency(self):
        number = self.settings["emergency_number"]

        if messagebox.askyesno(
            "Call emergency services?",
            f"This will open your phone app to call {number}.\n\nContinue only in an emergency.",
        ):
            webbrowser.open(f"tel:{number}")

    def message_contact(self):
        contact = self.settings["trusted_contact"]

        if not contact:
            messagebox.showinfo("Add a contact", "Add a trusted contact in Safety settings first.")
            return

        message = urllib.parse.quote("I need help. Please check in with me.")
        webbrowser.open(f"sms:{contact}?body={message}")

    def share_location(self):
        dialog = tk.Toplevel(self)
        dialog.title("Share location")
        dialog.configure(bg=BG)
        dialog.resizable(False, False)

        tk.Label(
            dialog,
            text="Create a location link",
            bg=BG,
            fg=INK,
            font=("Helvetica", 18, "bold"),
            pady=18,
        ).pack()

        tk.Label(
            dialog,
            text="Enter coordinates from your maps app.",
            bg=BG,
            fg=MUTED,
        ).pack(padx=28)

        tk.Label(dialog, text="Latitude", bg=BG, fg=INK, anchor="w").pack(
            fill="x", padx=28, pady=(14, 3)
        )
        latitude = tk.Entry(dialog, width=32)
        latitude.pack(padx=28, fill="x")

        tk.Label(dialog, text="Longitude", bg=BG, fg=INK, anchor="w").pack(
            fill="x", padx=28, pady=(14, 3)
        )
        longitude = tk.Entry(dialog, width=32)
        longitude.pack(padx=28, fill="x")

        def create_link():
            lat = latitude.get().strip()
            lon = longitude.get().strip()

            if not lat or not lon:
                messagebox.showwarning("Coordinates needed", "Enter both latitude and longitude.", parent=dialog)
                return

            webbrowser.open(f"https://maps.google.com/?q={lat},{lon}")
            dialog.destroy()

        tk.Button(
            dialog,
            text="Open shareable map link",
            command=create_link,
            bg=CORAL,
            fg="white",
            bd=0,
            padx=16,
            pady=10,
            font=("Helvetica", 11, "bold"),
        ).pack(pady=24)

    def bobify(self):
        self.bell()
        messagebox.showinfo(
            "Bobify guide",
            "Safety Float opens an emergency call.\n\n"
            "Care Package opens a message to your trusted contact.\n\n"
            "Location Pin creates a map link you can share.",
        )

    def open_settings(self):
        dialog = tk.Toplevel(self)
        dialog.title("Safety settings")
        dialog.configure(bg=BG)
        dialog.resizable(False, False)

        tk.Label(
            dialog,
            text="Safety settings",
            bg=BG,
            fg=INK,
            font=("Helvetica", 20, "bold"),
            pady=18,
        ).pack()

        tk.Label(dialog, text="Emergency number", bg=BG, fg=INK, anchor="w").pack(
            fill="x", padx=28, pady=(10, 3)
        )
        emergency_entry = tk.Entry(dialog, width=34)
        emergency_entry.insert(0, self.settings["emergency_number"])
        emergency_entry.pack(padx=28, fill="x")

        tk.Label(dialog, text="Trusted contact phone", bg=BG, fg=INK, anchor="w").pack(
            fill="x", padx=28, pady=(16, 3)
        )
        contact_entry = tk.Entry(dialog, width=34)
        contact_entry.insert(0, self.settings["trusted_contact"])
        contact_entry.pack(padx=28, fill="x")

        def save():
            self.settings["emergency_number"] = emergency_entry.get().strip()
            self.settings["trusted_contact"] = contact_entry.get().strip()
            self.save_settings()
            dialog.destroy()

        tk.Button(
            dialog,
            text="Save settings",
            command=save,
            bg=TEAL,
            fg="white",
            bd=0,
            padx=22,
            pady=10,
            font=("Helvetica", 11, "bold"),
        ).pack(pady=26)


if __name__ == "__main__":
    BobShop().mainloop()
