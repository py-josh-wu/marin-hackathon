import os
import json
import time
import threading
import tkinter as tk
from tkinter import messagebox

# Optional speech recognition imports
SPEECH_SUPPORTED = False
try:
    import speech_recognition as sr
    SPEECH_SUPPORTED = True
except ImportError:
    SPEECH_SUPPORTED = False


# ==========================================
# CONFIGURATION & VIBRANT COLOR PALETTE
# ==========================================
CONFIG_FILE = "bob_config.json"

THEME = {
    "bg": "#120924",               # Deep violet canvas
    "surface": "#1E1238",          # Rich purple card background
    "surface_hover": "#2A194C",    # Bright purple hover state
    "nav_bg": "#180D30",           # Dark indigo top bar
    "border": "#3B2567",           # Vivid purple border
    "border_hover": "#818CF8",     # Electric indigo glow border
    "accent_primary": "#6366F1",   # Vibrant indigo primary
    "accent_primary_hover": "#4F46E5",
    "accent_success": "#10B981",   # Bright emerald green
    "accent_success_hover": "#059669",
    "accent_warning": "#F59E0B",   # Amber gold
    "text_main": "#FFFFFF",        # Crisp white text
    "text_muted": "#C7D2FE",       # Soft lavender text
    "status_active": "#34D399",    # Glowing mint green
    "status_warn": "#FBBF24",      # Golden amber
    "status_error": "#F87171"      # Coral red
