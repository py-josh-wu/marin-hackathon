import os
import json
import time
import threading
import tkinter as tk
from tkinter import ttk, messagebox

# --- CONFIGURATION & STORAGE ---
CONFIG_FILE = "bob_config.json"

DEFAULT_CONFIG = {
    "first_run": True,
    "trigger_phrase": "hey bobify, can i buy a banana from hannah?",
    "contacts": ["Mom (+1 555-0199)", "911 Emergency Dispatch"],
    "covert_mode": True
}

def load_config():
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_CONFIG

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


# --- MAIN APPLICATION CLASS ---
class BobShopApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Bob Shop")
        self.geometry("420x680")
        self.configure(bg="#FFFFFF")
        self.resizable(False, False)

        self.config_data = load_config()
        self.is_listening = True

        # Start Background Voice Recognition Thread
        self.listener_thread = threading.Thread(target=self._background_mic_listener, daemon=True)
        self.listener_thread.start()

        # UI Routing based on state
        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    # ==========================================
    # 1. TUTORIAL / SETUP WIZARD (FIRST LAUNCH)
    # ==========================================
    def show_tutorial(self):
        self._clear_window()

        # Header / Branding
        header = tk.Frame(self, bg="#000000", height=80)
        header.pack(fill="x")
        
        lbl_title = tk.Label(
            header, 
            text="🛍️ BOB SHOP SETUP", 
            font=("Helvetica", 16, "bold"), 
            fg="#FFFFFF", 
            bg="#000000"
        )
        lbl_title.pack(pady=25)

        # Content Container
        content = tk.Frame(self, bg="#FFFFFF", padx=20, pady=20)
        content.pack(fill="both", expand=True)

        intro_text = (
            "WELCOME TO BOB SHOP\n\n"
            "This app acts as a covert personal safety tool disguised as a store.\n\n"
            "• Background Mic: Listens silently for your safe phrase.\n"
            "• Disguise: Once set up, re-opening the app presents a regular fruit shop.\n"
            "• Emergency Activation: Saying the phrase alerts selected contacts."
        )

        lbl_intro = tk.Label(
            content, 
            text=intro_text, 
            font=("Helvetica", 10), 
            bg="#FFFFFF", 
            justify="left", 
            wraplength=360
        )
        lbl_intro.pack(anchor="w", pady=(0, 15))

        # Secret Phrase Section
        tk.Label(content, text="Activation Phrase:", font=("Helvetica", 10, "bold"), bg="#FFFFFF").pack(anchor="w")
        self.ent_phrase = tk.Entry(content, font=("Helvetica", 10), width=45)
        self.ent_phrase.insert(0, self.config_data["trigger_phrase"])
        self.ent_phrase.pack(fill="x", pady=(2, 15))

        # Contacts Section
        tk.Label(content, text="Emergency Contacts (comma separated):", font=("Helvetica", 10, "bold"), bg="#FFFFFF").pack(anchor="w")
        self.ent_contacts = tk.Entry(content, font=("Helvetica", 10), width=45)
        self.ent_contacts.insert(0, ", ".join(self.config_data["contacts"]))
        self.ent_contacts.pack(fill="x", pady=(2, 20))

        # Save & Launch Store Button
        btn_finish = tk.Button(
            content,
            text="COMPLETE SETUP & LAUNCH STORE",
            font=("Helvetica", 11, "bold"),
            bg="#000000",
            fg="#FFFFFF",
            activebackground="#333333",
            activeforeground="#FFFFFF",
            bd=0,
            pady=12,
            command=self._finish_tutorial
        )
        btn_finish.pack(fill="x", side="bottom")

    def _finish_tutorial(self):
        phrase = self.ent_phrase.get().strip().lower()
        contacts_raw = self.ent_contacts.get().strip()

        if not phrase or not contacts_raw:
            messagebox.showwarning("Incomplete Setup", "Please specify both a secret phrase and emergency contacts.")
            return

        self.config_data["trigger_phrase"] = phrase
        self.config_data["contacts"] = [c.strip() for c in contacts_raw.split(",")]
        self.config_data["first_run"] = False
        save_config(self.config_data)

        messagebox.showinfo("Setup Complete", "Bob Shop is now active in disguise mode.")
        self.show_store_interface()

    # ==========================================
    # 2. DISGUISED SHOPPING INTERFACE
    # ==========================================
    def show_store_interface(self):
        self._clear_window()

        # Minimalist Top Bar (Black & White Theme)
        top_bar = tk.Frame(self, bg="#000000", height=60)
        top_bar.pack(fill="x")

        # Fake Logo Icon + Name
        lbl_logo = tk.Label(
            top_bar, 
            text="🛍️ BOB SHOP", 
            font=("Helvetica", 14, "bold"), 
            fg="#FFFFFF", 
            bg="#000000"
        )
        lbl_logo.pack(side="left", padx=20, pady=15)

        # Subtle Reset/Settings Button (Hidden in plain sight)
        btn_settings = tk.Button(
            top_bar,
            text="⚙️",
            font=("Helvetica", 12),
            bg="#000000",
            fg="#FFFFFF",
            bd=0,
            activebackground="#000000",
            activeforeground="#888888",
            command=self.show_tutorial
        )
        btn_settings.pack(side="right", padx=15)

        # Product Grid Container
        main_content = tk.Frame(self, bg="#FFFFFF", padx=15, pady=15)
        main_content.pack(fill="both", expand=True)

        tk.Label(
            main_content, 
            text="Fresh Produce Catalog", 
            font=("Helvetica", 12, "bold"), 
            bg="#FFFFFF"
        ).pack(anchor="w", pady=(0, 10))

        # Mock Products
        products = [
            (" Organic Bananas", "$1.29 / lb", "🍌"),
            (" Fuji Apples", "$2.49 / lb", "🍎"),
            (" Valencia Oranges", "$1.99 / lb", "🍊"),
            (" Fresh Strawberries", "$3.99 / box", "🍓")
        ]

        for name, price, icon in products:
            card = tk.Frame(main_content, bg="#F9F9F9", highlightbackground="#E0E0E0", highlightthickness=1, pady=10, padx=10)
            card.pack(fill="x", pady=6)

            lbl_icon = tk.Label(card, text=icon, font=("Segoe UI Emoji", 20), bg="#F9F9F9")
            lbl_icon.pack(side="left", padx=(5, 15))

            info_frame = tk.Frame(card, bg="#F9F9F9")
            info_frame.pack(side="left")

            tk.Label(info_frame, text=name, font=("Helvetica", 10, "bold"), bg="#F9F9F9").pack(anchor="w")
            tk.Label(info_frame, text=price, font=("Helvetica", 9), fg="#666666", bg="#F9F9F9").pack(anchor="w")

            btn_buy = tk.Button(
                card, 
                text="Add to Cart", 
                font=("Helvetica", 8, "bold"), 
                bg="#000000", 
                fg="#FFFFFF", 
                bd=0, 
                padx=10, 
                pady=5,
                command=lambda n=name: messagebox.showinfo("Bob Shop", f"Added {n} to cart.")
            )
            btn_buy.pack(side="right")

        # Hidden Status Indicator
        self.lbl_mic_status = tk.Label(
            main_content, 
            text="● Mic Active (Listening covertly)", 
            font=("Helvetica", 8), 
            fg="#A0A0A0", 
            bg="#FFFFFF"
        )
        self.lbl_mic_status.pack(side="bottom", pady=5)

    # ==========================================
    # 3. SECRET BACKGROUND SPEECH LISTENER
    # ==========================================
    def _background_mic_listener(self):
        """
        Monitors background audio for the secret activation phrase.
        Integrates with the speech_recognition library if installed,
        or operates in simulation mode as a fallback.
        """
        try:
            import speech_recognition as sr
            recognizer = sr.Recognizer()
            mic = sr.Microphone()

            with mic as source:
                recognizer.adjust_for_ambient_noise(source, duration=1)

            while self.is_listening:
                try:
                    with mic as source:
                        audio = recognizer.listen(source, timeout=3, phrase_time_limit=5)
                    text = recognizer.recognize_google(audio).lower()
                    
                    target_phrase = self.config_data.get("trigger_phrase", "").lower()
                    if target_phrase in text:
                        self._trigger_emergency_alert(detected_text=text)

                except (sr.WaitTimeoutError, sr.UnknownValueError):
                    pass
                except Exception as e:
                    time.sleep(1)

        except ImportError:
            # Fallback Simulation Engine (when speech_recognition module isn't installed)
            while self.is_listening:
                time.sleep(2)

    # ==========================================
    # 4. EMERGENCY DISPATCH DISGUISE ACTION
    # ==========================================
    def _trigger_emergency_alert(self, detected_text="Trigger Phrase Recognized"):
        """Executes the safe dispatch process when triggered."""
        contacts = ", ".join(self.config_data.get("contacts", []))
        
        # Log to terminal / console
        print("\n" + "="*50)
        print("🚨 [COVERT ALERT TRIGGERED] 🚨")
        print(f"Phrase Recognized: '{detected_text}'")
        print(f"Notifying Emergency Contacts: {contacts}")
        print("Dispatching GPS Coordinates & Silent Audio Stream...")
        print("="*50 + "\n")

        # Visual indicator on UI thread (silent alert frame)
        self.after(0, lambda: messagebox.showwarning(
            "Emergency Protocol Active", 
            f"[TEST MODE] Secret trigger detected!\n\nAlert sent to contacts:\n{contacts}"
        ))

    def _clear_window(self):
        for widget in self.winfo_children():
            widget.destroy()


# --- ENTRY POINT ---
if __name__ == "__main__":
    app = BobShopApp()
    app.mainloop()
