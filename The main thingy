        header.pack(fill="x")
        header.pack_propagate(False)

        logo_canvas = tk.Canvas(header, bg=THEME["nav_bg"], width=50, height=50, highlightthickness=0)
        logo_canvas.pack(side="left", padx=(25, 10), pady=15)
        self._draw_brand_logo(logo_canvas, 25, 25, scale=1.0)

        title_frame = tk.Frame(header, bg=THEME["nav_bg"])
        title_frame.pack(side="left", fill="y", pady=18)
        tk.Label(title_frame, text="BOB SHOP SETUP", font=("Helvetica", 14, "bold"), fg=THEME["text_main"], bg=THEME["nav_bg"]).pack(anchor="w")
        tk.Label(title_frame, text="Configure voice trigger & emergency contacts", font=("Helvetica", 9), fg=THEME["text_muted"], bg=THEME["nav_bg"]).pack(anchor="w")

        # Scrollable / Padded Container
        container = tk.Frame(self, bg=THEME["bg"], padx=30, pady=15)
        container.pack(fill="both", expand=True)

        # Trigger Card
        card_voice = tk.Frame(container, bg=THEME["surface"], padx=16, pady=12, highlightbackground=THEME["border"], highlightthickness=1)
        card_voice.pack(fill="x", pady=(0, 10))

        tk.Label(card_voice, text="🎙️ Secret Voice Activation Phrase", font=("Helvetica", 11, "bold"), fg=THEME["text_main"], bg=THEME["surface"]).pack(anchor="w")
        tk.Label(
            card_voice, 
            text="Speaking this phrase anywhere while active silently triggers an emergency alert.",
            font=("Helvetica", 8), fg=THEME["text_muted"], bg=THEME["surface"]
        ).pack(anchor="w", pady=(2, 6))

        self.ent_phrase = tk.Entry(
            card_voice, font=("Helvetica", 10), bg=THEME["bg"], fg=THEME["text_main"],
            insertbackground=THEME["text_main"], bd=0, highlightthickness=1, highlightbackground=THEME["border"]
        )
        self.ent_phrase.insert(0, self.config_data.get("trigger_phrase", ""))
        self.ent_phrase.pack(fill="x", ipady=6, padx=2)

        # Mappings Grid
        tk.Label(container, text="🛍️ Emergency Contact Mappings", font=("Helvetica", 11, "bold"), fg=THEME["text_main"], bg=THEME["bg"]).pack(anchor="w", pady=(5, 6))

        grid_container = tk.Frame(container, bg=THEME["bg"])
        grid_container.pack(fill="both", expand=True)

        self.contact_entries = {}
        current_mappings = self.config_data.get("fruit_contacts", DEFAULT_CONFIG["fruit_contacts"])

        for idx, (name, price, emoji) in enumerate(PRODUCTS_LIST):
            row_idx = idx // 3
            col_idx = idx % 3

            card = tk.Frame(grid_container, bg=THEME["surface"], highlightbackground=THEME["border"], highlightthickness=1, padx=10, pady=6)
            card.grid(row=row_idx, column=col_idx, sticky="ew", padx=5, pady=4)
            grid_container.grid_columnconfigure(col_idx, weight=1)

            lbl = tk.Label(card, text=f"{emoji} {name}", font=("Helvetica", 9, "bold"), fg=THEME["text_main"], bg=THEME["surface"])
            lbl.pack(anchor="w", pady=(0, 2))

            ent = tk.Entry(
