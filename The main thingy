import os
import json
import time
import threading
from PIL import Image, ImageDraw
import customtkinter as ctk
from tkinter import messagebox

# Set CustomTkinter theme / color palette
ctk.set_appearance_mode("Dark")  # Options: "System", "Dark", "Light"
ctk.set_default_color_theme("blue")  # Themes: "blue", "green", "dark-blue"

CONFIG_FILE = "bob_config.json"

DEFAULT_CONFIG = {
    "first_run": True,
    "trigger_phrase": "hey bobify, can i buy a banana from hannah?",
    "contacts": "Mom (+1 555-0199), 911 Emergency Dispatch",
    "covert_mode": True
}

def load_config():
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_CONFIG

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


class BobShopApp(ctk.CTk):
    def __init__(self):
        super().__init__()

        # Window Setup
        self.title("Bob Shop")
        self.geometry("400x720")
        self.resizable(False, False)
        
        # Modern App Background
        self.configure(fg_color="#0F0F11")

        self.config_data = load_config()
        self.is_listening = True

        # Generate Minimalist Shopping Bag Logo Icon dynamically
        self.bag_logo = self._create_bag_icon()

        # Start Speech Listener Thread
        self.listener_thread = threading.Thread(target=self._background_mic_listener, daemon=True)
        self.listener_thread.start()

        # Router
        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    # --- DYNAMIC MINIMALIST BLACK & WHITE SHOPPING BAG LOGO ---
    def _create_bag_icon(self):
        img = Image.new("RGBA", (80, 80), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        # Handle
        draw.arc([26, 12, 54, 38], start=180, end=0, fill="#FFFFFF", width=3)
        # Bag Body
        draw.rounded_rectangle([18, 28, 62, 70], radius=4, outline="#FFFFFF", width=3)
        return ctk.CTkImage(light_image=img, dark_image=img, size=(38, 38))

    # =========================================================
    # 1. MODERN TUTORIAL & ONBOARDING SETUP
    # =========================================================
    def show_tutorial(self):
        self._clear_window()

        # Header Frame
        header = ctk.CTkFrame(self, fg_color="#18181B", corner_radius=0, height=90)
        header.pack(fill="x")

        title_lbl = ctk.CTkLabel(
            header,
            text="BOB SHOP",
            image=self.bag_logo,
            compound="top",
            font=ctk.CTkFont(family="Inter", size=16, weight="bold"),
            text_color="#FFFFFF"
        )
        title_lbl.pack(pady=12)

        # Content Container
        scroll_container = ctk.CTkScrollableFrame(self, fg_color="transparent")
        scroll_container.pack(fill="both", expand=True, padx=20, pady=15)

        # Setup Badge
        badge = ctk.CTkLabel(
            scroll_container,
            text="SAFETY ASSISTANT SETUP",
            font=ctk.CTkFont(size=10, weight="bold"),
            text_color="#A1A1AA",
            fg_color="#27272A",
            corner_radius=6,
            padx=10,
            pady=4
        )
        badge.pack(anchor="w", pady=(0, 10))

        # Intro Card
        intro_card = ctk.CTkFrame(scroll_container, fg_color="#18181B", corner_radius=12)
        intro_card.pack(fill="x", pady=(0, 15))

        intro_msg = (
            "Bob Shop is a covert emergency protocol application disguised as a modern store interface.\n\n"
            "• Mic Continuous Scan: Silently listens for your activation phrase.\n"
            "• Automatic Disguise: Re-opening the app presents a regular store catalog."
        )
        intro_lbl = ctk.CTkLabel(
            intro_card,
            text=intro_msg,
            font=ctk.CTkFont(size=12),
            text_color="#D4D4D8",
            justify="left",
            wraplength=310
        )
        intro_lbl.pack(padx=15, pady=15)

        # Config Inputs
        ctk.CTkLabel(scroll_container, text="Activation Trigger Phrase", font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w", pady=(5, 2))
        self.ent_phrase = ctk.CTkEntry(
            scroll_container,
            height=40,
            corner_radius=8,
            fg_color="#18181B",
            border_color="#27272A",
            font=ctk.CTkFont(size=12)
        )
        self.ent_phrase.insert(0, self.config_data["trigger_phrase"])
        self.ent_phrase.pack(fill="x", pady=(0, 12))

        ctk.CTkLabel(scroll_container, text="Emergency Contacts", font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w", pady=(5, 2))
        self.ent_contacts = ctk.CTkEntry(
            scroll_container,
            height=40,
            corner_radius=8,
            fg_color="#18181B",
            border_color="#27272A",
            font=ctk.CTkFont(size=12)
        )
        self.ent_contacts.insert(0, self.config_data["contacts"])
        self.ent_contacts.pack(fill="x", pady=(0, 20))

        # Save Button
        btn_complete = ctk.CTkButton(
            self,
            text="Save Setup & Launch Disguise",
            height=45,
            corner_radius=10,
            fg_color="#FFFFFF",
            text_color="#000000",
            hover_color="#E4E4E7",
            font=ctk.CTkFont(size=13, weight="bold"),
            command=self._finish_tutorial
        )
        btn_complete.pack(fill="x", padx=20, pady=20)

    def _finish_tutorial(self):
        phrase = self.ent_phrase.get().strip().lower()
        contacts = self.ent_contacts.get().strip()

        if not phrase or not contacts:
            messagebox.showwarning("Incomplete", "Please fill in all setup fields.")
            return

        self.config_data["trigger_phrase"] = phrase
        self.config_data["contacts"] = contacts
        self.config_data["first_run"] = False
        save_config(self.config_data)

        self.show_store_interface()

    # =========================================================
    # 2. DISGUISED MODERN SHOPPING STORE
    # =========================================================
    def show_store_interface(self):
        self._clear_window()

        # Sleek Top Bar
        top_bar = ctk.CTkFrame(self, fg_color="#18181B", corner_radius=0, height=65)
        top_bar.pack(fill="x")

        brand_frame = ctk.CTkFrame(top_bar, fg_color="transparent")
        brand_frame.pack(side="left", padx=15, pady=10)

        lbl_logo = ctk.CTkLabel(brand_frame, text="", image=self.bag_logo)
        lbl_logo.pack(side="left", padx=(0, 10))

        lbl_name = ctk.CTkLabel(
            brand_frame,
            text="BOB SHOP",
            font=ctk.CTkFont(family="Inter", size=16, weight="bold"),
            text_color="#FFFFFF"
        )
        lbl_name.pack(side="left")

        # Covert Settings Gear
        btn_settings = ctk.CTkButton(
            top_bar,
            text="⚙️",
            width=32,
            height=32,
            fg_color="transparent",
            hover_color="#27272A",
            font=ctk.CTkFont(size=14),
            command=self.show_tutorial
        )
        btn_settings.pack(side="right", padx=15)

        # Store Feed
        content = ctk.CTkScrollableFrame(self, fg_color="transparent")
        content.pack(fill="both", expand=True, padx=15, pady=10)

        ctk.CTkLabel(content, text="Fresh Produce", font=ctk.CTkFont(size=14, weight="bold")).pack(anchor="w", pady=(5, 10))

        # Products Catalog
        products = [
            ("Organic Bananas", "$1.29 / lb", "🍌"),
            ("Fuji Apples", "$2.49 / lb", "🍎"),
            ("Valencia Oranges", "$1.99 / lb", "🍊"),
            ("Fresh Strawberries", "$3.99 / box", "🍓"),
            ("Avocado Bag", "$4.50 / ea", "🥑")
        ]

        for name, price, emoji in products:
            card = ctk.CTkFrame(content, fg_color="#18181B", corner_radius=12, height=70)
            card.pack(fill="x", pady=5)

            lbl_emoji = ctk.CTkLabel(card, text=emoji, font=ctk.CTkFont(size=24))
            lbl_emoji.pack(side="left", padx=15)

            details = ctk.CTkFrame(card, fg_color="transparent")
            details.pack(side="left", fill="y", pady=10)

            ctk.CTkLabel(details, text=name, font=ctk.CTkFont(size=13, weight="bold")).pack(anchor="w")
            ctk.CTkLabel(details, text=price, font=ctk.CTkFont(size=11), text_color="#A1A1AA").pack(anchor="w")

            btn_buy = ctk.CTkButton(
                card,
                text="Add",
                width=60,
                height=28,
                corner_radius=6,
                fg_color="#27272A",
                hover_color="#3F3F46",
                font=ctk.CTkFont(size=11, weight="bold"),
                command=lambda n=name: messagebox.showinfo("Bob Shop", f"Added {n} to cart.")
            )
            btn_buy.pack(side="right", padx=15)

        # Subtle Mic Status Footer
        footer = ctk.CTkFrame(self, fg_color="#18181B", corner_radius=0, height=30)
        footer.pack(fill="x", side="bottom")

        self.lbl_mic = ctk.CTkLabel(
            footer,
            text="● Live Protection Active",
            font=ctk.CTkFont(size=10),
            text_color="#22C55E"
        )
        self.lbl_mic.pack(pady=4)

    # =========================================================
    # 3. BACKGROUND VOICE RECOGNITION
    # =========================================================
    def _background_mic_listener(self):
        try:
            import speech_recognition as sr
            recognizer = sr.Recognizer()
            mic = sr.Microphone()

            with mic as source:
                recognizer.adjust_for_ambient_noise(source, duration=1)

            while self.is_listening:
                try:
                    with mic as source:
                        audio = recognizer.listen(source, timeout=3, phrase_time_limit=5)
                    text = recognizer.recognize_google(audio).lower()

                    target = self.config_data.get("trigger_phrase", "").lower()
                    if target in text:
                        self._trigger_alert(text)

                except (sr.WaitTimeoutError, sr.UnknownValueError):
                    pass
                except Exception:
                    time.sleep(1)

        except ImportError:
            # Fallback if SpeechRecognition or PyAudio are not installed
            while self.is_listening:
                time.sleep(2)

    def _trigger_alert(self, detected_text):
        contacts = self.config_data.get("contacts", "")
        print("\n" + "="*50)
        print("🚨 [ALERT ACTIVATED] 🚨")
        print(f"Detected Trigger: '{detected_text}'")
        print(f"Dispatching to Contacts: {contacts}")
        print("="*50 + "\n")

        self.after(0, lambda: messagebox.showwarning(
            "Protocol Triggered",
            f"[TEST MODE] Secret phrase recognized!\n\nDispatched emergency alert to:\n{contacts}"
        ))

    def _clear_window(self):
        for widget in self.winfo_children():
            widget.destroy()


if __name__ == "__main__":
    app = BobShopApp()
    app.mainloop()
