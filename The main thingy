    ("Avocado Bag", "$4.50 / ea", "🥑"),
    ("Organic Lemons", "$2.99 / bag", "🍋")
]

DEFAULT_CONFIG = {
    "first_run": True,
    "trigger_phrase": "hey bobify, can i buy a banana from hannah?",
    "default_contact": "911 Emergency Dispatch",
    "fruit_contacts": {
        "Organic Bananas": "Mom (+1 555-0199)",
        "Fuji Apples": "Dad (+1 555-0188)",
        "Valencia Oranges": "Sister (+1 555-0177)",
        "Fresh Strawberries": "Best Friend (+1 555-0166)",
        "Avocado Bag": "911 Emergency Dispatch",
        "Organic Lemons": "Campus Security (+1 555-0144)"
    }
}

def load_config():
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r") as f:
            cfg = json.load(f)
            if "fruit_contacts" not in cfg:
                cfg["fruit_contacts"] = DEFAULT_CONFIG["fruit_contacts"]
            return cfg
    except Exception:
        return DEFAULT_CONFIG

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


# ==========================================
# MAIN APPLICATION CLASS
# ==========================================
class BobShopApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("BOB SHOP")
        self.geometry("960x820")
        self.configure(bg=THEME["bg"])
        self.resizable(True, True)
        self.minsize(850, 700)

        self.config_data = load_config()
        self.is_listening = True
        self.mic_status_text = "Initializing Protection..."
        self.mic_status_color = THEME["status_warn"]

        # Speech Listener Thread
        self.listener_thread = threading.Thread(target=self._start_speech_recognition, daemon=True)
        self.listener_thread.start()

        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    # --- BRAND LOGO ---
    def _draw_brand_logo(self, canvas, center_x, center_y, scale=1.0):
        w = 16 * scale
        h = 20 * scale
        r = 8 * scale
        # Main bag body
        canvas.create_rectangle(
            center_x - w, center_y - (h/3), center_x + w, center_y + h,
            outline=THEME["accent_primary"], width=3, fill=THEME["surface"]
        )
        # Handle
        canvas.create_arc(
            center_x - r, center_y - (h/3 + r), center_x + r, center_y - (h/3 - r/2),
            start=0, extent=180, outline=THEME["accent_primary"], width=3, style=tk.ARC
        )

    # ==========================================
    # 1. SETUP & CONFIGURATION SCREEN
    # ==========================================
    def show_tutorial(self):
        self._clear_window()

        # Modern Vibrant Header
        header = tk.Frame(self, bg=THEME["nav_bg"], height=95)
        header.pack(fill="x")
        header.pack_propagate(False)

        logo_canvas = tk.Canvas(header, bg=THEME["nav_bg"], width=60, height=60, highlightthickness=0)
        logo_canvas.pack(side="left", padx=(30, 10), pady=18)
        self._draw_brand_logo(logo_canvas, 30, 30, scale=1.1)

        title_frame = tk.Frame(header, bg=THEME["nav_bg"])
        title_frame.pack(side="left", fill="y", pady=22)
        tk.Label(title_frame, text="BOB SHOP SETUP", font=("Helvetica", 15, "bold"), fg=THEME["text_main"], bg=THEME["nav_bg"]).pack(anchor="w")
        tk.Label(title_frame, text="Configure voice trigger & emergency contacts", font=("Helvetica", 9), fg=THEME["text_muted"], bg=THEME["nav_bg"]).pack(anchor="w")

        # Container
        container = tk.Frame(self, bg=THEME["bg"], padx=40, pady=25)
        container.pack(fill="both", expand=True)

        # Trigger Card
        card_voice = tk.Frame(container, bg=THEME["surface"], padx=20, pady=18, highlightbackground=THEME["border"], highlightthickness=2)
        card_voice.pack(fill="x", pady=(0, 20))

        tk.Label(card_voice, text="🎙️ Secret Voice Activation Phrase", font=("Helvetica", 11, "bold"), fg=THEME["text_main"], bg=THEME["surface"]).pack(anchor="w")
        tk.Label(
            card_voice, 
            text="Speaking this phrase anywhere while active silently triggers an emergency alert.",
            font=("Helvetica", 9), fg=THEME["text_muted"], bg=THEME["surface"]
        ).pack(anchor="w", pady=(2, 12))

        self.ent_phrase = tk.Entry(
            card_voice, font=("Helvetica", 11), bg=THEME["bg"], fg=THEME["text_main"],
            insertbackground=THEME["text_main"], bd=0, highlightthickness=2, highlightbackground=THEME["border"]
        )
        self.ent_phrase.insert(0, self.config_data.get("trigger_phrase", ""))
        self.ent_phrase.pack(fill="x", ipady=8, padx=2)

        # Contact Mappings Grid
        tk.Label(container, text="🛍️ Emergency Contact Mappings", font=("Helvetica", 12, "bold"), fg=THEME["text_main"], bg=THEME["bg"]).pack(anchor="w", pady=(5, 12))

        grid_container = tk.Frame(container, bg=THEME["bg"])
        grid_container.pack(fill="both", expand=True)

        self.contact_entries = {}
        current_mappings = self.config_data.get("fruit_contacts", DEFAULT_CONFIG["fruit_contacts"])

        for idx, (name, price, emoji) in enumerate(PRODUCTS_LIST):
            row_idx = idx // 2
            col_idx = idx % 2

            card = tk.Frame(grid_container, bg=THEME["surface"], highlightbackground=THEME["border"], highlightthickness=2, padx=14, pady=12)
            card.grid(row=row_idx, column=col_idx, sticky="ew", padx=8, pady=6)
            grid_container.grid_columnconfigure(col_idx, weight=1)

            lbl = tk.Label(card, text=f"{emoji} {name}", font=("Helvetica", 10, "bold"), fg=THEME["text_main"], bg=THEME["surface"])
            lbl.pack(anchor="w", pady=(0, 6))

            ent = tk.Entry(
                card, font=("Helvetica", 10), bg=THEME["bg"], fg=THEME["text_main"],
                insertbackground=THEME["text_main"], bd=0, highlightthickness=1, highlightbackground=THEME["border"]
            )
            ent.insert(0, current_mappings.get(name, "911 Emergency Dispatch"))
            ent.pack(fill="x", ipady=6)

            self.contact_entries[name] = ent

        # Complete Setup CTA Button
        btn_complete = tk.Button(
            self, text="Save Settings & Open Store", font=("Helvetica", 11, "bold"),
            bg=THEME["accent_success"], fg="#FFFFFF", activebackground=THEME["accent_success_hover"], activeforeground="#FFFFFF",
            bd=0, pady=14, cursor="hand2", command=self._finish_tutorial
        )
        btn_complete.pack(fill="x", padx=40, pady=20, side="bottom")

    def _finish_tutorial(self):
        phrase = self.ent_phrase.get().strip().lower()
        if not phrase:
            messagebox.showwarning("Incomplete Setup", "Please specify a voice phrase.")
            return

        fruit_contacts = {}
        for name, ent in self.contact_entries.items():
            val = ent.get().strip()
            fruit_contacts[name] = val if val else "911 Emergency Dispatch"

        self.config_data["trigger_phrase"] = phrase
        self.config_data["fruit_contacts"] = fruit_contacts
        self.config_data["first_run"] = False
        save_config(self.config_data)

        self.show_store_interface()

    # ==========================================
    # 2. VIBRANT STORE FRONTEND
    # ==========================================
    def show_store_interface(self):
        self._clear_window()

        # Navigation Header
        nav = tk.Frame(self, bg=THEME["nav_bg"], height=70)
        nav.pack(fill="x")
        nav.pack_propagate(False)

        logo_canvas = tk.Canvas(nav, bg=THEME["nav_bg"], width=45, height=45, highlightthickness=0)
        logo_canvas.pack(side="left", padx=(25, 8), pady=12)
        self._draw_brand_logo(logo_canvas, 22, 22, scale=0.9)

        lbl_brand = tk.Label(nav, text="BOB SHOP", font=("Helvetica", 14, "bold"), fg=THEME["text_main"], bg=THEME["nav_bg"])
        lbl_brand.pack(side="left")

        # Header Settings Button
        btn_settings = tk.Button(
            nav, text="⚙️ Settings", font=("Helvetica", 9, "bold"),
            bg=THEME["surface"], fg=THEME["text_main"],
            activebackground=THEME["accent_primary"], activeforeground="#FFFFFF",
            bd=0, padx=16, pady=8, cursor="hand2", command=self.show_tutorial
        )
        btn_settings.pack(side="right", padx=25)

        # Catalog Area
        main_content = tk.Frame(self, bg=THEME["bg"], padx=30, pady=20)
        main_content.pack(fill="both", expand=True)

        header_box = tk.Frame(main_content, bg=THEME["bg"])
        header_box.pack(fill="x", pady=(0, 15))

        tk.Label(header_box, text="Fresh Organic Produce", font=("Helvetica", 16, "bold"), fg=THEME["text_main"], bg=THEME["bg"]).pack(side="left")

        # Product Grid
        grid_frame = tk.Frame(main_content, bg=THEME["bg"])
        grid_frame.pack(fill="both", expand=True)

        for idx, (name, price, icon) in enumerate(PRODUCTS_LIST):
            row_idx = idx // 3
            col_idx = idx % 3

            # Vivid Product Card
            card = tk.Frame(
                grid_frame, bg=THEME["surface"],
                highlightbackground=THEME["border"], highlightthickness=2,
                padx=16, pady=16
            )
            card.grid(row=row_idx, column=col_idx, sticky="nsew", padx=10, pady=10)
            grid_frame.grid_columnconfigure(col_idx, weight=1)
            grid_frame.grid_rowconfigure(row_idx, weight=1)

            # Icon Display
            lbl_icon = tk.Label(card, text=icon, font=("Segoe UI Emoji", 38), bg=THEME["surface"])
            lbl_icon.pack(anchor="center", pady=(5, 8))

            # Product Details
            lbl_title = tk.Label(card, text=name, font=("Helvetica", 12, "bold"), fg=THEME["text_main"], bg=THEME["surface"])
            lbl_title.pack(anchor="center")

            lbl_price = tk.Label(card, text=price, font=("Helvetica", 10, "bold"), fg=THEME["text_muted"], bg=THEME["surface"])
            lbl_price.pack(anchor="center", pady=(2, 14))

            # Styled Vibrant Button
            btn_buy = tk.Button(
                card, text="Add to Cart 🛒", font=("Helvetica", 9, "bold"),
                bg=THEME["accent_primary"], fg="#FFFFFF",
                activebackground=THEME["accent_primary_hover"], activeforeground="#FFFFFF",
                bd=0, padx=18, pady=8, cursor="hand2",
                command=lambda n=name: self._on_product_clicked(n)
            )
            btn_buy.pack(anchor="center", side="bottom")

            # Bind Hover Interactions
            self._attach_hover_effect(card, [lbl_icon, lbl_title, lbl_price])

        # Bottom Status Footer
        self.footer = tk.Frame(self, bg=THEME["nav_bg"], height=40)
        self.footer.pack(fill="x", side="bottom")

        status_container = tk.Frame(self.footer, bg=THEME["nav_bg"])
        status_container.pack(expand=True, pady=8)

        self.canvas_pulse = tk.Canvas(status_container, width=12, height=12, bg=THEME["nav_bg"], highlightthickness=0)
        self.canvas_pulse.pack(side="left", padx=(0, 8))

        self.lbl_mic_status = tk.Label(
            status_container, text=self.mic_status_text,
            font=("Helvetica", 9, "bold"), fg=self.mic_status_color, bg=THEME["nav_bg"]
        )
        self.lbl_mic_status.pack(side="left")

        self._apply_status_ui()

    # --- DYNAMIC CARD HOVER ENGINE ---
    def _attach_hover_effect(self, card_widget, children):
        def on_enter(e):
            card_widget.config(bg=THEME["surface_hover"], highlightbackground=THEME["border_hover"])
            for child in children:
                child.config(bg=THEME["surface_hover"])

        def on_leave(e):
            card_widget.config(bg=THEME["surface"], highlightbackground=THEME["border"])
            for child in children:
                child.config(bg=THEME["surface"])

        card_widget.bind("<Enter>", on_enter)
        card_widget.bind("<Leave>", on_leave)
        for child in children:
            child.bind("<Enter>", on_enter)
            child.bind("<Leave>", on_leave)

    def _on_product_clicked(self, product_name):
        assigned_contact = self.config_data.get("fruit_contacts", {}).get(product_name, "911 Emergency Dispatch")

        messagebox.showinfo("Bob Shop", f"Added {product_name} to cart.")

        print("\n" + "="*50)
        print(f"🚨 [TOUCH ALERT DISPATCHED - {product_name.upper()}] 🚨")
        print(f"Contact Dispatched: {assigned_contact}")
        print("="*50 + "\n")

    # ==========================================
    # 3. SPEECH RECOGNITION ENGINE
    # ==========================================
    def _start_speech_recognition(self):
        if not SPEECH_SUPPORTED:
            self._update_status("● Speech Libraries Missing (pip install SpeechRecognition pyaudio)", THEME["status_error"])
            return

        recognizer = sr.Recognizer()
        recognizer.energy_threshold = 300
        recognizer.dynamic_energy_threshold = True

        try:
            mic = sr.Microphone()
        except Exception:
            self._update_status("● Microphone Access Error", THEME["status_error"])
            return

        self._update_status("Calibrating Ambient Noise...", THEME["status_warn"])
        try:
            with mic as source:
                recognizer.adjust_for_ambient_noise(source, duration=1.5)
            self._update_status("Live Protection Active", THEME["status_active"])
        except Exception:
            self._update_status("Mic Initialization Failed", THEME["status_error"])
            return

        while self.is_listening:
            try:
                with mic as source:
                    audio = recognizer.listen(source, timeout=3, phrase_time_limit=6)

                detected_text = recognizer.recognize_google(audio).lower()
                print(f"[Mic Heard]: '{detected_text}'")

                target_phrase = self.config_data.get("trigger_phrase", "").lower()
                if target_phrase in detected_text:
                    self._trigger_alert(detected_text)

            except (sr.WaitTimeoutError, sr.UnknownValueError):
                pass
            except sr.RequestError:
                self._update_status("Speech Network Error", THEME["status_error"])
                time.sleep(3)
                self._update_status("Live Protection Active", THEME["status_active"])
            except Exception:
                time.sleep(1)

    def _update_status(self, message, color):
        self.mic_status_text = message
        self.mic_status_color = color
        self.after(0, lambda: self._apply_status_ui())

    def _apply_status_ui(self):
        if hasattr(self, 'lbl_mic_status') and self.lbl_mic_status.winfo_exists():
            self.lbl_mic_status.config(text=self.mic_status_text, fg=self.mic_status_color)
            if hasattr(self, 'canvas_pulse') and self.canvas_pulse.winfo_exists():
                self.canvas_pulse.delete("all")
                self.canvas_pulse.create_oval(1, 1, 11, 11, fill=self.mic_status_color, outline="")

    def _trigger_alert(self, detected_text):
        contacts_summary = ", ".join(self.config_data.get("fruit_contacts", {}).values())
        print("\n" + "="*50)
        print("🚨 [VOICE PROTOCOL ACTIVATED] 🚨")
        print(f"Detected Secret Phrase: '{detected_text}'")
        print(f"Notifying Emergency Contacts: {contacts_summary}")
        print("="*50 + "\n")

        self.after(0, lambda: messagebox.showwarning(
            "Emergency Protocol Active",
            f"[TEST MODE] Voice phrase detected!\n\nRecognized Audio: '{detected_text}'\n\nAlert sent to contacts:\n{contacts_summary}"
        ))

    def _clear_window(self):
        for widget in self.winfo_children():
            widget.destroy()


# ==========================================
# EXECUTION ENTRY POINT
