    def _dispatch_location_broadcast(self):
        """Discreetly broadcasts current location to all configured contacts from Settings."""
        sid = self.ent_tw_sid.get().strip() or self.config_data.get("twilio_account_sid", "").strip()
        token = self.ent_tw_token.get().strip() or self.config_data.get("twilio_auth_token", "").strip()
        from_phone = self.ent_tw_phone.get().strip() or self.config_data.get("twilio_phone_number", "").strip()
        custom_note = self.txt_notes.get("1.0", tk.END).strip()

        loc_data = get_current_location()

        # Collect contact numbers
        contacts = []
        for name, ent in self.contact_entries.items():
            val = ent.get().strip()
            if val:
                contacts.append(val)
        
        if not contacts:
            contacts = list(self.config_data.get("fruit_contacts", {}).values())

        unique_numbers = list(set(contacts))

        broadcast_msg = f"📍 LOCATION BROADCAST:\n\nCurrent Location:\n{loc_data}"
        if custom_note:
            broadcast_msg += f"\n\nNote:\n{custom_note}"

        for num in unique_numbers:
            send_real_sms(sid, token, from_phone, num, broadcast_msg)

        messagebox.showinfo(
            "Find My Active 📍",
            f"Discreetly broadcasted live location to ALL {len(unique_numbers)} contacts!\n\nLocation Data:\n{loc_data}"
        )

    def _finish_tutorial(self):
        phrase = self.ent_phrase.get().strip().lower()
        if not phrase:
            messagebox.showwarning("Incomplete Setup", "Please specify a voice phrase.")
            return

        notes = self.txt_notes.get("1.0", tk.END).strip()
        tw_sid = self.ent_tw_sid.get().strip()
        tw_token = self.ent_tw_token.get().strip()
        tw_phone = self.ent_tw_phone.get().strip()

        fruit_contacts = {}
        for name, ent in self.contact_entries.items():
            val = ent.get().strip()
            fruit_contacts[name] = val if val else "+15550199"

        self.config_data["twilio_account_sid"] = tw_sid
        self.config_data["twilio_auth_token"] = tw_token
        self.config_data["twilio_phone_number"] = tw_phone
        self.config_data["trigger_phrase"] = phrase
        self.config_data["custom_notes"] = notes
        self.config_data["fruit_contacts"] = fruit_contacts
        self.config_data["first_run"] = False
        save_config(self.config_data)

        self.show_store_interface()

