    # --- BUTTON CLICK HANDLER ---
    def _on_product_clicked(self, product_name):
        assigned_number = self.config_data.get("fruit_contacts", {}).get(product_name, "+15550199")
        custom_note = self.config_data.get("custom_notes", "").strip()

        # Build message payload including custom notes
        sms_message = f"Alert: An item ({product_name}) was selected in Bob Shop."
        if custom_note:
            sms_message += f"\n\nAdditional Note:\n{custom_note}"

        sent_status = send_real_sms(assigned_number, sms_message)

        if sent_status:
            messagebox.showinfo("Bob Shop", f"Added {product_name} to cart.\n\n📲 SMS Alert dispatched to {assigned_number}")
        else:
            messagebox.showinfo("Bob Shop", f"Added {product_name} to cart.\n\n⚠️ SMS not sent (Check Twilio credentials). Target: {assigned_number}")

    # --- BACKGROUND SPEECH MONITORING ---
    def _start_speech_recognition(self):
        if not SPEECH_SUPPORTED or not self.recognizer:
            self._update_status("● Speech Libraries Missing", THEME["status_error"])
            return

        try:
            mic = sr.Microphone()
        except Exception:
            self._update_status("● Microphone Access Error", THEME["status_error"])
            return

        self._update_status("Calibrating Ambient Noise...", THEME["status_warn"])
        try:
            with mic as source:
                self.recognizer.adjust_for_ambient_noise(source, duration=1.5)
            self._update_status("Live Protection Active", THEME["status_active"])
        except Exception:
            self._update_status("Mic Initialization Failed", THEME["status_error"])
            return

        while self.is_listening:
            try:
                with mic as source:
                    audio = self.recognizer.listen(source, timeout=3, phrase_time_limit=6)

                detected_text = self.recognizer.recognize_google(audio).lower()
                target_phrase = self.config_data.get("trigger_phrase", "").lower()

                if target_phrase in detected_text:
                    self._trigger_voice_alert(detected_text)

            except (sr.WaitTimeoutError, sr.UnknownValueError):
                pass
            except Exception:
                time.sleep(1)

    def _trigger_voice_alert(self, detected_text):
        """Triggers real SMS alerts containing custom notes for all contacts."""
        contacts = list(self.config_data.get("fruit_contacts", {}).values())
        unique_numbers = list(set(contacts))
        custom_note = self.config_data.get("custom_notes", "").strip()

        sms_message = f"🚨 EMERGENCY ALERT: Secret phrase detected! Audio: '{detected_text}'"
        if custom_note:
            sms_message += f"\n\nAdditional Note:\n{custom_note}"

        for number in unique_numbers:
            send_real_sms(number, sms_message)

        self.after(0, lambda: messagebox.showwarning(
            "Emergency Protocol Active",
            f"Voice phrase detected!\n\nRecognized Audio: '{detected_text}'\n\n📲 Dispatching SMS alerts with notes to {len(unique_numbers)} numbers."
        ))

    def _update_status(self, message, color):
        self.mic_status_text = message
        self.mic_status_color = color
        self.after(0, lambda: self._apply_status_ui())

    def _apply_status_ui(self):
        if hasattr(self, 'lbl_mic_status') and self.lbl_mic_status.winfo_exists():
            self.lbl_mic_status.config(text=self.mic_status_text, fg=self.mic_status_color)
            if hasattr(self, 'canvas_pulse') and self.canvas_pulse.winfo_exists():
                self.canvas_pulse.delete("all")
                self.canvas_pulse.create_oval(1, 1, 11, 11, fill=self.mic_status_color, outline="")

    def _clear_window(self):
        for widget in self.winfo_children():
            widget.destroy()


