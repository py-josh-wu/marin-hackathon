        self.is_listening = True
        self.mic_status_text = "Initializing Protection..."
        self.mic_status_color = THEME["status_warn"]
        self.is_ai_active = False

        if SPEECH_SUPPORTED:
            self.recognizer = sr.Recognizer()
            self.recognizer.energy_threshold = 300
            self.recognizer.dynamic_energy_threshold = True
        else:
            self.recognizer = None

        self.listener_thread = threading.Thread(target=self._start_speech_recognition, daemon=True)
        self.listener_thread.start()

        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    def _draw_brand_logo(self, canvas, center_x, center_y, scale=1.0):
        w = 16 * scale
        h = 20 * scale
        r = 8 * scale
        canvas.create_rectangle(
            center_x - w, center_y - (h/3), center_x + w, center_y + h,
            outline=THEME["accent_primary"], width=3, fill=THEME["surface"]
        )
        canvas.create_arc(
            center_x - r, center_y - (h/3 + r), center_x + r, center_y - (h/3 - r/2),
            start=0, extent=180, outline=THEME["accent_primary"], width=3, style=tk.ARC
        )

