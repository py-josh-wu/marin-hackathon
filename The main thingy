"""BobShop: transparent, accessibility-first emergency-tool catalog.

Install for desktop preview:  pip install kivy plyer
For Android packaging, use Buildozer and declare CALL_PHONE, SEND_SMS, and
ACCESS_FINE_LOCATION permissions only if your release actually needs them.
"""
from kivy.app import App
from kivy.lang import Builder
from kivy.properties import BooleanProperty, StringProperty
from kivy.uix.popup import Popup
from kivy.uix.label import Label
from kivy.utils import platform

try:
    from plyer import sms, tts, gps
except ImportError:  # Makes the UI previewable before device integrations exist.
    sms = tts = gps = None


KV = '''
#:import dp kivy.metrics.dp
<ProductButton@Button>:
    background_normal: ''
    background_color: '#FFFFFF'
    color: '#1E2927'
    font_size: '16sp'
    halign: 'left'
    valign: 'middle'
    text_size: self.width - dp(28), self.height
    padding: dp(14), dp(10)

BoxLayout:
    orientation: 'vertical'
    padding: dp(20)
    spacing: dp(12)
    canvas.before:
        Color:
            rgb: 1, .976, .945
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: 'BobShop'
        color: '#214E4A'
        font_size: '31sp'
        bold: True
        size_hint_y: None
        height: dp(45)
        halign: 'left'
        text_size: self.width, self.height
    Label:
        text: 'Safety tools catalog — every item clearly explains its action.'
        color: '#52615E'
        size_hint_y: None
        height: dp(42)
        halign: 'left'
        text_size: self.width, self.height
    ProductButton:
        text: '🛟  Safety Float    $0.00\\nCall emergency services'
        on_release: app.confirm_call()
    ProductButton:
        text: '📦  Care Package    $0.00\\nMessage a trusted contact'
        on_release: app.message_contact()
    ProductButton:
        text: '📍  Location Pin    $0.00\\nShare your current location'
        on_release: app.share_location()
    ProductButton:
        text: '🔔  Bobify Guide    $0.00\\nHear the emergency options aloud'
        on_release: app.bobify()
    Widget:
    Button:
        text: 'Safety settings'
        size_hint_y: None
        height: dp(50)
        background_normal: ''
        background_color: '#E96A47'
        on_release: app.show_settings()
'''


class BobShop(App):
    emergency_number = StringProperty('911')
    trusted_contact = StringProperty('')
    voice_guidance = BooleanProperty(True)

    def build(self):
        self.title = 'BobShop'
        return Builder.load_string(KV)

    def popup(self, title, message):
        Popup(title=title, content=Label(text=message, padding=(20, 20)),
              size_hint=(.85, None), height=190).open()

    def speak(self, message):
        if self.voice_guidance and tts:
            tts.speak(message)

    def confirm_call(self):
        # This confirmation is deliberate: no emergency action is hidden.
        self.popup('Call emergency services?',
                   'This action would call {}. Only continue in an emergency.\n\n'
                   'On Android, connect this button to an intent after obtaining '
                   'the appropriate permission and showing a final confirmation.'.format(self.emergency_number))

    def message_contact(self):
        if not self.trusted_contact:
            self.popup('Add a trusted contact', 'Set a phone number in Safety settings first.')
            return
        if sms:
            sms.send(recipient=self.trusted_contact, message='I need help. Please check in with me.')
        else:
            self.popup('Message trusted contact', 'Would open the system message composer for {}.'.format(self.trusted_contact))

    def share_location(self):
        if not gps:
            self.popup('Share location', 'Location sharing requires a device build with Plyer GPS support.')
            return
        gps.configure(on_location=self._got_location)
        gps.start(minTime=1000, minDistance=0)
        self.popup('Finding location', 'BobShop is requesting your location to create a shareable link.')

    def _got_location(self, **location):
        gps.stop()
        link = 'https://maps.google.com/?q={lat},{lon}'.format(**location)
        self.popup('Location ready', 'Share this location link through your preferred app:\n{}'.format(link))

    def bobify(self):
        message = ('Bobify guide. Safety Float calls emergency services. '
                   'Care Package messages your trusted contact. '
                   'Location Pin shares your current location.')
        self.speak(message)
        self.popup('Bobify is speaking', message)

    def show_settings(self):
        self.popup('Safety settings',
                   'Configure an emergency number and trusted contact in your '
                   'production settings screen. Do not store contacts or location '
                   'without informed user consent.')


if __name__ == '__main__':
    BobShop().run()
