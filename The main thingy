import os
import json
import time
import threading
import tkinter as tk
from tkinter import messagebox

# Optional speech recognition imports
SPEECH_SUPPORTED = False
try:
    import speech_recognition as sr
    SPEECH_SUPPORTED = True
except ImportError:
    SPEECH_SUPPORTED = False


# ==========================================
# CONFIGURATION & STORAGE
# ==========================================
CONFIG_FILE = "bob_config.json"

PRODUCTS_LIST = [
    ("Organic Bananas", "🍌"),
    ("Fuji Apples", "🍎"),
    ("Valencia Oranges", "🍊"),
    ("Fresh Strawberries", "🍓"),
    ("Avocado Bag", "🥑")
]

DEFAULT_CONFIG = {
    "first_run": True,
    "trigger_phrase": "hey bobify, can i buy a banana from hannah?",
    "default_contact": "911 Emergency Dispatch",
    "fruit_contacts": {
        "Organic Bananas": "Mom (+1 555-0199)",
        "Fuji Apples": "Dad (+1 555-0188)",
        "Valencia Oranges": "Sister (+1 555-0177)",
        "Fresh Strawberries": "Best Friend (+1 555-0166)",
        "Avocado Bag": "911 Emergency Dispatch"
    }
}

def load_config():
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r") as f:
            cfg = json.load(f)
            # Ensure fruit contacts dict exists
            if "fruit_contacts" not in cfg:
                cfg["fruit_contacts"] = DEFAULT_CONFIG["fruit_contacts"]
            return cfg
    except Exception:
        return DEFAULT_CONFIG

def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


# ==========================================
# MAIN APPLICATION CLASS
# ==========================================
class BobShopApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Bob Shop")
        self.geometry("420x780")
        self.configure(bg="#0F0F11")
        self.resizable(False, False)

        self.config_data = load_config()
        self.is_listening = True
        self.mic_status_text = "Initializing Mic..."
        self.mic_status_color = "#EAB308"

        # Start Speech Listener Thread
        self.listener_thread = threading.Thread(target=self._start_speech_recognition, daemon=True)
        self.listener_thread.start()

        if self.config_data.get("first_run", True):
            self.show_tutorial()
        else:
            self.show_store_interface()

    # --- CANVAS-DRAWN LOGO ---
    def _draw_shopping_bag_logo(self, canvas, center_x, center_y):
        canvas.create_rectangle(
            center_x - 18, center_y - 10, center_x + 18, center_y + 22,
            outline="#FFFFFF", width=3, fill="#0F0F11"
        )
        canvas.create_arc(
            center_x - 10, center_y - 20, center_x + 10, center_y - 2,
            start=0, extent=180, outline="#FFFFFF", width=3, style=tk.ARC
        )

    # ==========================================
    # 1. SETUP & CONTACT SETTINGS SCREEN
    # ==========================================
    def show_tutorial(self):
        self._clear_window()

        # Canvas Header
        header_canvas = tk.Canvas(self, bg="#18181B", height=90, highlightthickness=0)
        header_canvas.pack(fill="x")
        self._draw_shopping_bag_logo(header_canvas, 210, 32)
        header_canvas.create_text(210, 72, text="BOB SHOP SETUP", fill="#FFFFFF", font=("Helvetica", 12, "bold"))

        body = tk.Frame(self, bg="#0F0F11", padx=20, pady=10)
        body.pack(fill="both", expand=True)

        # Trigger Phrase Field
        tk.Label(body, text="Secret Voice Activation Phrase:", font=("Helvetica", 9, "bold"), fg="#FFFFFF", bg="#0F0F11").pack(anchor="w", pady=(5, 2))
        self.ent_phrase = tk.Entry(
            body, font=("Helvetica", 10), bg="#18181B", fg="#FFFFFF",
            insertbackground="#FFFFFF", bd=0, highlightthickness=1, highlightbackground="#27272A"
        )
        self.ent_phrase.insert(0, self.config_data.get("trigger_phrase", ""))
        self.ent_phrase.pack(fill="x", ipady=6, pady=(0, 10))

        # Fruit-to-Contact Assignment Section
        tk.Label(body, text="Assign Emergency Contacts to Items:", font=("Helvetica", 9, "bold"), fg="#FFFFFF", bg="#0F0F11").pack(anchor="w", pady=(5, 5))

        self.contact_entries = {}
        current_mappings = self.config_data.get("fruit_contacts", DEFAULT_CONFIG["fruit_contacts"])

        for name, emoji in PRODUCTS_LIST:
            row = tk.Frame(body, bg="#18181B", highlightbackground="#27272A", highlightthickness=1, padx=8, pady=4)
            row.pack(fill="x", pady=3)

            lbl = tk.Label(row, text=f"{emoji} {name}", font=("Helvetica", 9, "bold"), fg="#FFFFFF", bg="#18181B", width=18, anchor="w")
            lbl.pack(side="left")

            ent = tk.Entry(
                row, font=("Helvetica", 9), bg="#0F0F11", fg="#FFFFFF",
                insertbackground="#FFFFFF", bd=0, highlightthickness=1, highlightbackground="#27272A"
            )
            ent.insert(0, current_mappings.get(name, "911 Emergency Dispatch"))
            ent.pack(side="right", fill="x", expand=True, ipady=4)

            self.contact_entries[name] = ent

        # Complete Setup Button
        btn_complete = tk.Button(
            self, text="SAVE & LAUNCH STORE DISGUISE", font=("Helvetica", 10, "bold"),
            bg="#FFFFFF", fg="#000000", activebackground="#E4E4E7", activeforeground="#000000",
            bd=0, pady=10, cursor="hand2", command=self._finish_tutorial
        )
        btn_complete.pack(fill="x", padx=20, pady=15, side="bottom")

    def _finish_tutorial(self):
        phrase = self.ent_phrase.get().strip().lower()
        if not phrase:
            messagebox.showwarning("Incomplete Setup", "Please set an activation phrase.")
            return

        fruit_contacts = {}
        for name, ent in self.contact_entries.items():
            val = ent.get().strip()
            fruit_contacts[name] = val if val else "911 Emergency Dispatch"

        self.config_data["trigger_phrase"] = phrase
        self.config_data["fruit_contacts"] = fruit_contacts
        self.config_data["first_run"] = False
        save_config(self.config_data)

        self.show_store_interface()

    # ==========================================
    # 2. DISGUISED STORE WITH TOUCH DISPATCH
    # ==========================================
    def show_store_interface(self):
        self._clear_window()

        # Navbar
        top_bar = tk.Frame(self, bg="#18181B", height=50)
        top_bar.pack(fill="x")
        top_bar.pack_propagate(False)

        logo_canvas = tk.Canvas(top_bar, bg="#18181B", width=40, height=45, highlightthickness=0)
        logo_canvas.pack(side="left", padx=(15, 5), pady=3)
        self._draw_shopping_bag_logo(logo_canvas, 20, 22)

        lbl_title = tk.Label(top_bar, text="BOB SHOP", font=("Helvetica", 12, "bold"), fg="#FFFFFF", bg="#18181B")
        lbl_title.pack(side="left")

        btn_settings = tk.Button(
            top_bar, text="⚙️", font=("Helvetica", 11), bg="#18181B", fg="#A1A1AA",
            activebackground="#18181B", bd=0, cursor="hand2", command=self.show_tutorial
        )
        btn_settings.pack(side="right", padx=15)

        # Store Feed
        content = tk.Frame(self, bg="#0F0F11", padx=15, pady=12)
        content.pack(fill="both", expand=True)

        tk.Label(content, text="Fresh Produce Catalog", font=("Helvetica", 11, "bold"), fg="#FFFFFF", bg="#0F0F11").pack(anchor="w", pady=(0, 8))

        products_data = [
            ("Organic Bananas", "$1.29 / lb", "🍌"),
            ("Fuji Apples", "$2.49 / lb", "🍎"),
            ("Valencia Oranges", "$1.99 / lb", "🍊"),
            ("Fresh Strawberries", "$3.99 / box", "🍓"),
            ("Avocado Bag", "$4.50 / ea", "🥑")
        ]

        for name, price, icon in products_data:
            card = tk.Frame(content, bg="#18181B", highlightbackground="#27272A", highlightthickness=1, padx=12, pady=8)
            card.pack(fill="x", pady=4)

            lbl_icon = tk.Label(card, text=icon, font=("Segoe UI Emoji", 18), bg="#18181B")
            lbl_icon.pack(side="left", padx=(0, 10))

            info = tk.Frame(card, bg="#18181B")
            info.pack(side="left")

            tk.Label(info, text=name, font=("Helvetica", 9, "bold"), fg="#FFFFFF", bg="#18181B").pack(anchor="w")
            tk.Label(info, text=price, font=("Helvetica", 8), fg="#A1A1AA", bg="#18181B").pack(anchor="w")

            btn_buy = tk.Button(
                card, text="Add", font=("Helvetica", 8, "bold"), bg="#27272A", fg="#FFFFFF",
                activebackground="#3F3F46", bd=0, padx=10, pady=4, cursor="hand2",
                command=lambda n=name: self._on_product_clicked(n)
            )
            btn_buy.pack(side="right")

        # Footer Status
        self.footer = tk.Frame(self, bg="#18181B", height=28)
        self.footer.pack(fill="x", side="bottom")

        self.lbl_mic_status = tk.Label(
            self.footer, text=self.mic_status_text, font=("Helvetica", 8),
            fg=self.mic_status_color, bg="#18181B"
        )
        self.lbl_mic_status.pack(pady=5)

    def _on_product_clicked(self, product_name):
        """Simulates adding product to cart while triggering alert to assigned contact."""
        assigned_contact = self.config_data.get("fruit_contacts", {}).get(product_name, "911 Emergency Dispatch")

        # Visual store cover
        messagebox.showinfo("Bob Shop", f"Added {product_name} to cart.")

        # Silent dispatch log & alert
        print("\n" + "="*50)
        print(f"🚨 [TOUCH ALERT DISPATCHED - {product_name.upper()}] 🚨")
        print(f"Contact Dispatched: {assigned_contact}")
        print("="*50 + "\n")

    # ==========================================
    # 3. VOICE SPEECH RECOGNITION ENGINE
    # ==========================================
    def _start_speech_recognition(self):
        if not SPEECH_SUPPORTED:
            self._update_status("● Speech Libraries Missing (pip install SpeechRecognition pyaudio)", "#EF4444")
            return

        recognizer = sr.Recognizer()
        recognizer.energy_threshold = 300
        recognizer.dynamic_energy_threshold = True

        try:
            mic = sr.Microphone()
        except Exception:
            self._update_status("● Microphone Access Error", "#EF4444")
            return

        self._update_status("● Calibrating Ambient Noise...", "#EAB308")
        try:
            with mic as source:
                recognizer.adjust_for_ambient_noise(source, duration=1.5)
            self._update_status("● Live Protection Active (Listening)", "#22C55E")
        except Exception:
            self._update_status("● Mic Initialization Failed", "#EF4444")
            return

        while self.is_listening:
            try:
                with mic as source:
                    audio = recognizer.listen(source, timeout=3, phrase_time_limit=6)

                detected_text = recognizer.recognize_google(audio).lower()
                print(f"[Mic Heard]: '{detected_text}'")

                target_phrase = self.config_data.get("trigger_phrase", "").lower()
                if target_phrase in detected_text:
                    self._trigger_alert(detected_text)

            except (sr.WaitTimeoutError, sr.UnknownValueError):
                pass
            except sr.RequestError:
                self._update_status("● Speech Network Error", "#EF4444")
                time.sleep(3)
                self._update_status("● Live Protection Active (Listening)", "#22C55E")
            except Exception:
                time.sleep(1)

    def _update_status(self, message, color):
        self.mic_status_text = message
        self.mic_status_color = color
        self.after(0, lambda: self._apply_status_ui())

    def _apply_status_ui(self):
        if hasattr(self, 'lbl_mic_status') and self.lbl_mic_status.winfo_exists():
            self.lbl_mic_status.config(text=self.mic_status_text, fg=self.mic_status_color)

    def _trigger_alert(self, detected_text):
        contacts_summary = ", ".join(self.config_data.get("fruit_contacts", {}).values())
        print("\n" + "="*50)
        print("🚨 [VOICE PROTOCOL ACTIVATED] 🚨")
        print(f"Detected Secret Phrase: '{detected_text}'")
        print(f"Notifying Emergency Contacts: {contacts_summary}")
        print("="*50 + "\n")

        self.after(0, lambda: messagebox.showwarning(
            "Emergency Protocol Active",
            f"[TEST MODE] Voice phrase detected!\n\nRecognized Audio: '{detected_text}'\n\nAlert sent to contacts:\n{contacts_summary}"
        ))

    def _clear_window(self):
        for widget in self.winfo_children():
            widget.destroy()


# ==========================================
# EXECUTION ENTRY POINT
# ==========================================
if __name__ == "__main__":
    app = BobShopApp()
    app.mainloop()
